---
import Newsletter from "../components/Newsletter.astro";
import { websiteCredits } from "../lib/content";
interface Props {
	content: {
		copyright: string;
		links?: Array<{ col: number; text: string; href: string }>;
		social?: Array<{ name: string; url: string }>;
		pressReleases?: Array<{ text: string; href: string }>;
		previousYears?: Array<{ text: string; href: string }>;
		newsletter: {
			prefix: string;
			heading: string;
			description: string;
			ctaText: string;
			ctaHref: string;
		};
	};
}

const { content } = Astro.props;
const currentYear = new Date().getFullYear();

/** Set to `true` to show the newsletter block above the copyright. */
const showFooterNewsletter = false;

function linkOpensInNewTab(href: string): boolean {
	const h = href.trim();
	if (h.startsWith('http://') || h.startsWith('https://') || h.startsWith('//')) {
		return true;
	}
	// Meet the Team (same-tab internal links otherwise)
	return h.startsWith('/our-team');
}
---

<footer class="footer">
	<div class="footer-container">
		<div class="footer-top">
			<div class="footer-column footer-brand">
				<div class="footer-logo">
					<img
						src="/images/Cloud-summit-logo.svg"
						alt="Cloud Summit 2026"
					/>
				</div>
				{
					content.social && (
						<div class="footer-social">
							{content.social.map((social) => (
								<a
									href={social.url}
									target="_blank"
									rel="noopener noreferrer"
									aria-label={social.name}
								>
									{social.name === "Instagram" && (
										<svg
											xmlns="http://www.w3.org/2000/svg"
											width="24"
											height="24"
											viewBox="0 0 24 24"
											fill="none"
											stroke="currentColor"
											stroke-width="2"
											stroke-linecap="round"
											stroke-linejoin="round"
										>
											<rect
												width="20"
												height="20"
												x="2"
												y="2"
												rx="5"
												ry="5"
											/>
											<path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
											<line
												x1="17.5"
												x2="17.51"
												y1="6.5"
												y2="6.5"
											/>
										</svg>
									)}
									{social.name === "LinkedIn" && (
										<svg
											xmlns="http://www.w3.org/2000/svg"
											width="24"
											height="24"
											viewBox="0 0 24 24"
											fill="none"
											stroke="currentColor"
											stroke-width="2"
											stroke-linecap="round"
											stroke-linejoin="round"
										>
											<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
											<rect
												width="4"
												height="12"
												x="2"
												y="9"
											/>
											<circle cx="4" cy="4" r="2" />
										</svg>
									)}
								</a>
							))}
						</div>
					)
				}
			</div>

			<div class="footer-column">
				<h4 class="footer-heading">To Do</h4>
				{
					content.links && (
						<nav class="footer-nav">
							{content.links
								.filter((link) => link.col === 1)
								.map((link) => (
									<a
										href={link.href}
										target={linkOpensInNewTab(link.href) ? '_blank' : undefined}
										rel={linkOpensInNewTab(link.href) ? 'noopener noreferrer' : undefined}
									>
										{link.text}
									</a>
								))}
						</nav>
					)
				}
			</div>
			<div class="footer-column">
				<h4 class="footer-heading">About</h4>
				{
					content.links && (
						<nav class="footer-nav">
							{content.links
								.filter((link) => link.col === 2)
								.map((link) => (
									<a
										href={link.href}
										target={linkOpensInNewTab(link.href) ? '_blank' : undefined}
										rel={linkOpensInNewTab(link.href) ? 'noopener noreferrer' : undefined}
									>
										{link.text}
									</a>
								))}
						</nav>
					)
				}
			</div>
			<div class="footer-column">
				<h4 class="footer-heading">Previous Years</h4>
				{
					content.links && (
						<nav class="footer-nav footer-nav--two-col">
							{content.links
								.filter((link) => link.col === 3)
								.map((link) => (
									<a
										href={link.href}
										target={linkOpensInNewTab(link.href) ? '_blank' : undefined}
										rel={linkOpensInNewTab(link.href) ? 'noopener noreferrer' : undefined}
									>
										{link.text}
									</a>
								))}
						</nav>
					)
				}
			</div>
		</div>

		{showFooterNewsletter && <Newsletter content={content.newsletter} />}

		<div class="footer-bottom">
			<p class="footer-copyright">
				© {currentYear}
				{content.copyright}
			</p>
			<p class="footer-website-credit">
				Website by{" "}
				{
					websiteCredits.map((item, idx) => (
						<span>
							{item.link ? (
								<a
									href={item.link}
									target="_blank"
									rel="noopener noreferrer"
								>
									{item.name}
								</a>
							) : (
								item.name
							)}
							{idx < websiteCredits.length - 1 ? ", " : ""}
						</span>
					))
				}
			</p>
		</div>
	</div>
</footer>

<script>
	import { getCityStore } from "../lib/cityStore";
	import { citySpecificContent } from "../lib/content";
	import type { City } from "../lib/content";

	// Update city-dependent footer links when the selected city changes
	function updateFooterLinks() {
		const cityStore = getCityStore();
		const currentCity = cityStore.getCity();

		const ticketLinks = document.querySelectorAll(
			'.footer-nav a[href*="luma.com"]',
		) as NodeListOf<HTMLAnchorElement>;

		ticketLinks.forEach((link) => {
			link.href = citySpecificContent[currentCity].ticketUrl;
		});

		const callForSpeakersLinks = Array.from(
			document.querySelectorAll('.footer-nav a'),
		).filter((link) => {
			try {
				return new URL(link.href).pathname === '/our-speakers/';
			} catch {
				return false;
			}
		});

		callForSpeakersLinks.forEach((link) => {
			link.href = citySpecificContent[currentCity].callForSpeakersFooterUrl;
		});
	}

	// Initialize and subscribe to city changes
	function initCityAwareFooter() {
		const cityStore = getCityStore();
		cityStore.init();

		// Update city-specific footer links on initial load
		updateFooterLinks();

		// Subscribe to city changes
		cityStore.subscribe((city: City) => {
			updateFooterLinks();
		});
	}

	// Run when DOM is ready
	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initCityAwareFooter);
	} else {
		initCityAwareFooter();
	}
</script>

<style>
	.footer {
		background: black;
		color: white;
		padding: 3rem 1.5rem 2rem;
		border-top: 1px solid rgba(255, 255, 255, 0.1);
	}

	.footer-container {
		max-width: 1200px;
		margin: 0 auto;
	}

	.footer-top {
		display: grid;
		grid-template-columns: 1fr;
		gap: 2rem;
		margin-bottom: 2rem;
	}

	.footer-column {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.footer-brand {
		align-items: center;
		text-align: center;
	}

	.footer-logo img {
		height: 2.5rem;
		width: auto;
	}

	/* Match CloudSummitActivities .activity-title + yellow theme accent */
	.footer-heading {
		font-family: 'Squada One', system-ui, sans-serif;
		font-size: 1.5rem;
		font-weight: 400;
		letter-spacing: 0.02em;
		margin: 0 0 0.75rem 0;
		line-height: 1.2;
		color: rgb(255, 193, 77);
	}

	.footer-nav {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	/* Mobile: show footer link details in 2 columns */
	@media (max-width: 768px) {
		.footer-nav {
			display: block;
			columns: 2;
			column-gap: 1.75rem;
		}

		/* For short lists (e.g. Previous Years), force real 2 columns */
		.footer-nav.footer-nav--two-col {
			columns: unset;
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			column-gap: 1.75rem;
		}

		.footer-nav a {
			display: inline-block;
			width: 100%;
			margin: 0 0 0.75rem 0;
			break-inside: avoid;
		}

		.footer-nav.footer-nav--two-col a {
			margin: 0;
		}
	}

	/* Match .activity-description */
	.footer-nav a {
		color: white;
		text-decoration: none;
		font-size: 1rem;
		line-height: 1.6;
		opacity: 0.9;
		transition: opacity 0.2s;
	}

	.footer-nav a:hover {
		opacity: 1;
	}

	.footer-social {
		display: flex;
		gap: 1rem;
	}

	.footer-social a {
		color: white;
		text-decoration: none;
		transition: color 0.2s;
	}

	.footer-social a:hover {
		color: rgb(61, 120, 171);
	}

	.footer-social svg {
		width: 24px;
		height: 24px;
	}

	.footer-bottom {
		width: 100%;
		text-align: center;
		padding-top: 1.5rem;
		border-top: 1px solid rgba(255, 255, 255, 0.1);
	}

	.footer-copyright {
		margin: 0;
		font-size: 0.875rem;
		opacity: 0.7;
	}

	.footer-website-credit {
		margin: 1rem 0 0 0;
		font-size: 0.75rem;
		line-height: 1.5;
		text-align: center;
		font-weight: 600;
		color: white;
		opacity: 0.9;
	}

	.footer-website-credit a {
		color: inherit;
		text-decoration: none;
	}

	.footer-website-credit a:hover {
		text-decoration: underline;
	}

	@media (min-width: 769px) {
		.footer {
			padding: 4rem 2rem 2rem;
		}

		.footer-top {
			grid-template-columns: 2fr 1fr 1fr 1fr;
			gap: 3rem;
		}

		.footer-brand {
			align-items: flex-start;
			text-align: left;
		}

		.footer-logo img {
			height: 3rem;
		}

		.footer-heading {
			font-size: 1.75rem;
		}

		.footer-nav a {
			font-size: 1.125rem;
		}

		.footer-nav--two-col {
			columns: 2;
			column-gap: 1.75rem;
		}

		.footer-nav--two-col a {
			display: inline-block;
			width: 100%;
			margin: 0 0 0.75rem 0;
			break-inside: avoid;
		}

		.footer-copyright {
			font-size: 1rem;
		}
	}
</style>
