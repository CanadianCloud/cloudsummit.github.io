import type { City, VenueLogisticsSectionNewVersion } from "../lib/content";


interface Props {
  content: Record<City, VenueLogisticsSectionNewVersion>;
}

const { content } = Astro.props;



const allCitiesLogistics = Object.values(content);
const getVenueIcon = (title: string) => {
  const t = title.toLowerCase();
  if (t.includes('getting here')) return '🚌';
  if (t.includes('transit')) return '🚌';
  if (t.includes('public transport')) return '🚌';
  if (t.includes('parking')) return '🅿️';
  if (t.includes('accessible')) return '♿';
  if (t.includes('bike')) return '🚲';
  if (t.includes('mobi')) return '🚲';
  if (t.includes('ferry')) return '⛴️';
  if (t.includes('car share')) return '🚗';
  if (t.includes('automated entry') || t.includes('entry and exit')) return '🚪';
  if (t.includes('ramp') || t.includes('elevator')) return '🛗';
  if (t.includes('service animals')) return '🐾';
  if (t.includes('washrooms')) return '🚻';
  return '📍';
};

const getVenueFaIcon = (title: string) => {
  const t = title.toLowerCase();
  if (t.includes('getting to the venue')) return 'fa-solid fa-location-dot';
  if (t.includes('public transport')) return 'fa-solid fa-bus';
  if (t.includes('active & shared mobility')) return 'fa-solid fa-bicycle';
  if (t.includes('vehicle access')) return 'fa-solid fa-car';
  if (t.includes('accessibility')) return 'fa-solid fa-universal-access';
  return 'fa-solid fa-circle-info';
};

const parseSubtitleLine = (line: string) => {
  const trimmed = line.trim();
  const entries: Array<[string, string, string]> = [
    ['Bus Routes', 'fa-solid fa-bus', 'Bus Routes'],
    ['Bus Rotes', 'fa-solid fa-bus', 'Bus Routes'],
    ['Skytrain', 'fa-solid fa-train-subway', 'SkyTrain'],
    ['Ferry', 'fa-solid fa-ship', 'Ferry'],
    ['Accessible Parking', 'fa-solid fa-square-parking', 'Accessible Parking'],
    ['Automated Entry and Exit Doors', 'fa-solid fa-door-open', 'Automated Entry and Exit Doors'],
    ['Ramps and Elevators', 'fa-solid fa-elevator', 'Ramps and Elevators'],
    ['Service Animals', 'fa-solid fa-paw', 'Service Animals'],
    ['Washrooms', 'fa-solid fa-restroom', 'Washrooms'],
  ];
  for (const [match, iconClass, label] of entries) {
    if (trimmed === match) return { iconClass, label };
  }

  const emojiMap: Array<[string, string]> = [
    ['🚲', 'fa-solid fa-bicycle'],
    ['🚗', 'fa-solid fa-car'],
    ['🅿️', 'fa-solid fa-square-parking'],
    ['🚪', 'fa-solid fa-door-open'],
    ['🛗', 'fa-solid fa-elevator'],
    ['🐾', 'fa-solid fa-paw'],
    ['🚻', 'fa-solid fa-restroom'],
    ['💲', 'fa-solid fa-dollar-sign'],
    ['💳', 'fa-solid fa-credit-card'],
    ['⚠️', 'fa-solid fa-triangle-exclamation'],
  ];
  for (const [emoji, iconClass] of emojiMap) {
    if (trimmed.startsWith(emoji)) {
      const label = trimmed.replace(emoji, '').trim();
      return { iconClass, label };
    }
  }
  return null;
};
---

{
  allCitiesLogistics.map((cityData) => (
    <div
      data-city-box
      {...{ [`data-city-${cityData.CityTitle.toLowerCase()}-box`]: true }}
    >      
      <div class="Box venue-logistics-title-box">
        <div class="venue-logistics-header">
          <h2 class="section-heading venue-logistics-heading">
            <span class="heading-prefix">Venue </span>
            Logistics
          </h2>
          <p class="venue-logistics-intro">{cityData.intro}</p>
        </div>
      </div>
      <div class="venue-logistics-grid-wrap">
        <div class="venue-logistics-grid">
          {cityData.section.map((item) => (
            <div
              class:list={[
                'venue-logistics-card',
                { 'venue-logistics-card--full': item.title === 'Accessibility & Facilities' },
              ]}
            >
              {/** Render "Ferry" after the CTA area (not in bullets) */}
              {(() => {
                const ferryIndex = item.bullets.findIndex((b) => b === 'Ferry');
                const deferredSubtitles = ferryIndex >= 0 ? item.bullets.slice(ferryIndex) : [];
                const visibleBullets = ferryIndex >= 0 ? item.bullets.slice(0, ferryIndex) : item.bullets;
                return (
                  <>
              <div class="venue-logistics-card-header">
                <span class="venue-logistics-card-icon" aria-hidden="true">
                  <i class={getVenueFaIcon(item.title)} aria-hidden="true"></i>
                </span>
                <h3 class="venue-logistics-card-title">{item.title}</h3>
              </div>

              <div class="venue-logistics-card-body">
                {item.title === 'Getting to the Venue' && (
                  <img
                    class="venue-logistics-card-image"
                    src="/images/vanue/vanue.png"
                    alt="Map view for getting to the venue"
                    loading="lazy"
                    decoding="async"
                  />
                )}
                {visibleBullets.map((bullet) => {
                  const isParagraph = bullet.length > 120;
                  if (isParagraph) {
                    return <p class="venue-logistics-paragraph">{bullet}</p>;
                  }
                  
                  if (bullet === 'Science World has button-operated automated entry doors and exit doors.') {
                    return <p class="venue-logistics-paragraph">{bullet}</p>;
                  }

                  if (
                    bullet ===
                    'All public washrooms at Science World are equipped with baby-change facilities.'
                  ) {
                    return <p class="venue-logistics-paragraph">{bullet}</p>;
                  }

                  const isSubheading =
                    bullet === 'Bus Routes' ||
                    bullet === 'Skytrain' ||
                    bullet === 'Bus Rotes';

                  if (isSubheading) {
                    const parsed = parseSubtitleLine(bullet);
                    return (
                      <div class="venue-logistics-subtitle">
                        {parsed ? <i class={parsed.iconClass} aria-hidden="true"></i> : null}
                        <span>{parsed ? parsed.label : bullet}</span>
                      </div>
                    );
                  }

                  // Accessibility & Facilities headings (no emoji in content)
                  if (
                    bullet === 'Accessible Parking' ||
                    bullet === 'Automated Entry and Exit Doors' ||
                    bullet === 'Ramps and Elevators' ||
                    bullet === 'Service Animals' ||
                    bullet === 'Washrooms'
                  ) {
                    const parsed = parseSubtitleLine(bullet);
                    return (
                      <div class="venue-logistics-subtitle">
                        {parsed ? <i class={parsed.iconClass} aria-hidden="true"></i> : null}
                        <span>{parsed ? parsed.label : bullet}</span>
                      </div>
                    );
                  }

                  if (bullet.trim().startsWith('🚲')) {
                    const parsed = parseSubtitleLine(bullet);
                    return (
                      <div class="venue-logistics-subtitle">
                        {parsed ? <i class={parsed.iconClass} aria-hidden="true"></i> : null}
                        <span>{parsed ? parsed.label : bullet}</span>
                      </div>
                    );
                  }

                  if (
                    bullet.trim().startsWith('🚗') ||
                    bullet.trim().startsWith('🅿️') ||
                    bullet.trim().startsWith('🚪') ||
                    bullet.trim().startsWith('🛗') ||
                    bullet.trim().startsWith('🐾') ||
                    bullet.trim().startsWith('🚻') ||
                    bullet.trim().startsWith('💲') ||
                    bullet.trim().startsWith('💳') ||
                    bullet.trim().startsWith('⚠️')
                  ) {
                    const parsed = parseSubtitleLine(bullet);
                    return (
                      <div class="venue-logistics-subtitle">
                        {parsed ? <i class={parsed.iconClass} aria-hidden="true"></i> : null}
                        <span>{parsed ? parsed.label : bullet}</span>
                      </div>
                    );
                  }

                  if (bullet === '604.443.7440') {
                    return (
                      <div class="venue-logistics-bullet-row">
                        <span class="venue-logistics-check" aria-hidden="true">
                          •
                        </span>
                        <a href="tel:+16044437440" class="venue-logistics-inline-link">
                          604.443.7440
                        </a>
                      </div>
                    );
                  }

                  if (bullet === 'Directions via Google Maps') {
                    const mapsLink = item.externalLink?.find(
                      (l) => l.text === 'Directions via Google Maps' && Boolean(l.url),
                    );
                    if (!mapsLink?.url) {
                      return null;
                    }
                    return (
                      <div class="venue-logistics-inline-cta">
                        <a
                          href={mapsLink.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="venue-logistics-cta"
                        >
                          {mapsLink.text}
                        </a>
                      </div>
                    );
                  }

                  const matchingLink = item.externalLink?.find(
                    (link) => link.text === bullet && Boolean(link.url),
                  );

                  const trimmed = bullet.trim();
                  const isCheckItem = trimmed.startsWith('✔');
                  const checkText = isCheckItem ? '✔' : '•';
                  const displayText = isCheckItem
                    ? trimmed.replace(/^✔\s*/, '')
                    : bullet;

                  return (
                    <div class="venue-logistics-bullet-row">
                      <span class="venue-logistics-check" aria-hidden="true">
                        {checkText}
                      </span>
                      {matchingLink ? (
                        <a
                          href={matchingLink.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="venue-logistics-inline-link"
                        >
                          {displayText}
                        </a>
                      ) : (
                        <span>{displayText}</span>
                      )}
                    </div>
                  );
                })}
              </div>

              {item.externalLink && item.externalLink.length > 0 && (
                <div class="venue-logistics-card-footer">
                  {(item.title === 'Public Transport'
                    ? item.externalLink.filter((link) => link.text === 'View Schedule')
                    : item.externalLink.filter((link) => link.text !== 'Directions via Google Maps')
                  ).map((link) => (
                    <a
                      href={link.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="venue-logistics-cta"
                    >
                      {link.text}
                    </a>
                  ))}
                </div>
              )}
              {deferredSubtitles.length > 0 && (
                <div class="venue-logistics-after-footer">
                  {deferredSubtitles.map((line, idx) => {
                    const isTitle =
                      idx === 0 ||
                      line === 'Routes connect from:' ||
                      line === 'Aquabus and False Creek Ferries Routes connect from:';
                    if (isTitle) {
                      return (
                        <div
                          class:list={[
                            'venue-logistics-subtitle',
                            {
                              'venue-logistics-subtitle--normal':
                                line === 'Aquabus and False Creek Ferries Routes connect from:',
                            },
                          ]}
                        >
                          {line}
                        </div>
                      );
                    }
                    return (
                      <div class="venue-logistics-bullet-row venue-logistics-bullet-row--after-footer">
                        <span class="venue-logistics-check" aria-hidden="true">
                          ✓
                        </span>
                        <span>{line}</span>
                      </div>
                    );
                  })}
                  {item.title === 'Public Transport' && item.externalLink && item.externalLink.length > 0 && (
                    <div class="venue-logistics-after-footer-ctas">
                      {item.externalLink
                        .filter(
                          (link) =>
                            link.text !== 'View Schedule' &&
                            link.text !== 'Directions via Google Maps',
                        )
                        .map((link) => (
                          <a
                            href={link.url}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="venue-logistics-cta"
                          >
                            {link.text}
                          </a>
                        ))}
                    </div>
                  )}
                </div>
              )}
                  </>
                );
              })()}
            </div>
          ))}
        </div>
      </div>
    </div>
  ))
}

