---
---

<section class="local-charity" aria-labelledby="local-charity-title">
	<div class="charity-container">
		<div class="charity-heart" aria-hidden="true">
			<i class="fa-solid fa-hand-holding-heart"></i>
		</div>

		<h2 id="local-charity-title" class="sponsors-heading">
			<span class="sponsors-prefix">All Profits Donated to </span>Local Charity
		</h2>

		<div class="charity-box">
			<p class="charity-description">
				This event is 100% community-run and focused. No organizers are paid, and no organizers profit in any way from the event. We are proud to support local charities in each city, with a shared goal of raising $10,000.
			</p>

			<div id="local-charity-vancouver" class="charity-city charity-city--vancouver">
				<p class="charity-city-text">
					Our Vancouver charity partner is Union Gospel Mission (UGM). UGM provides meals, education, shelter, safe and affordable housing, recovery programs, and support services for individuals experiencing homelessness and addiction in Metro Vancouver and Mission. In 2025, the Vancouver community successfully raised $10,000 for UGM.
				</p>
				<img
					class="charity-city-logo"
					src="/images/charity-and-community%20/unionGospelMission.svg"
					alt="Union Gospel Mission logo"
				/>
				<a
					class="charity-button"
					href="https://ugm.ca/"
					target="_blank"
					rel="noopener noreferrer"
					aria-label="Learn more about Union Gospel Mission"
				>
					Learn More About UGM
				</a>
			</div>

			<div id="local-charity-toronto" class="charity-city charity-city--toronto">
				<p class="charity-city-text">
					Our Toronto charity partner is Eva's Initiatives for Homeless Youth (Eva's). Eva's provides shelter, transitional housing, and life-changing programs to help homeless and at-risk youth build brighter futures.
				</p>
				<img
					class="charity-city-logo"
					src="/images/charity-and-community%20/Evas.png"
					alt="Eva's Initiatives for Homeless Youth logo"
				/>
				<a
					class="charity-button"
					href="https://www.evas.ca/"
					target="_blank"
					rel="noopener noreferrer"
					aria-label="Learn more about Eva's Initiatives for Homeless Youth"
				>
					Learn More About Eva's
				</a>
			</div>
		</div>
	</div>
</section>

<script>
	import { getCityStore } from "../lib/cityStore";
	import type { City } from "../lib/content";

	function syncCityCopy(city: City) {
		const vancouverEl = document.getElementById("local-charity-vancouver");
		const torontoEl = document.getElementById("local-charity-toronto");
		if (!vancouverEl || !torontoEl) return;

		const showVancouver = city === "vancouver";
		vancouverEl.classList.toggle("charity-city--hidden", !showVancouver);
		vancouverEl.setAttribute("aria-hidden", showVancouver ? "false" : "true");

		torontoEl.classList.toggle("charity-city--hidden", showVancouver);
		torontoEl.setAttribute("aria-hidden", showVancouver ? "true" : "false");
	}

	function initCityAwareCharity() {
		const cityStore = getCityStore();
		cityStore.init();
		syncCityCopy(cityStore.getCity());
		cityStore.subscribe(syncCityCopy);
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initCityAwareCharity);
	} else {
		initCityAwareCharity();
	}
</script>

<style>
	.local-charity {
		background: black;
		color: white;
		padding: 4rem 1.5rem;
	}

	.charity-container {
		max-width: 1200px;
		margin: 0 auto;
		text-align: center;
	}

	.charity-heart {
		color: rgb(168, 251, 90);
		font-size: 2.75rem;
		line-height: 1;
		margin: 0 0 1rem 0;
	}

	.sponsors-heading {
		font-family: 'Squada One', system-ui, sans-serif;
		font-size: 2.5rem;
		font-weight: 400;
		margin: 0 0 1rem 0;
		line-height: 1.2;
		letter-spacing: 0.02em;
		color: rgb(168, 251, 90);
	}

	.sponsors-prefix {
		color: white;
		font-family: 'Squada One', system-ui, sans-serif;
		font-size: 2.5rem;
		font-weight: 400;
		letter-spacing: 0.02em;
	}

	.charity-box {
		background: rgba(61, 120, 171, 0.1);
		border: 1px solid rgba(61, 120, 171, 0.2);
		border-radius: 1rem;
		padding: 2rem 1.5rem;
		max-width: 1000px;
		margin: 0 auto;
	}

	.charity-description {
		font-size: 1.125rem;
		line-height: 1.6;
		margin: 0 auto 1.2rem;
		max-width: 800px;
		opacity: 0.9;
	}

	.charity-city {
		display: block;
	}

	.charity-city--hidden {
		display: none !important;
	}

	.charity-city-text {
		font-size: 1.125rem;
		line-height: 1.6;
		margin: 0 auto 1.2rem;
		max-width: 800px;
		opacity: 0.95;
	}

	.charity-city-logo {
		display: block;
		margin: 0 auto 1.1rem;
		max-width: 260px;
		width: 100%;
		height: auto;
	}

	.charity-button {
		display: inline-block;
		padding: 1rem 3rem;
		background: rgb(168, 251, 90);
		color: black;
		text-decoration: none;
		font-weight: 600;
		border-radius: 0.5rem;
		font-size: 1.125rem;
		transition: transform 0.2s, opacity 0.2s;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.charity-button:hover {
		transform: translateY(-2px);
		opacity: 0.9;
	}

	@media (min-width: 769px) {
		.local-charity {
			padding: 6rem 2rem;
		}

		.sponsors-heading {
			font-size: 4rem;
			margin-bottom: 1.25rem;
		}

		.sponsors-prefix {
			font-size: 4rem;
		}

		.charity-box {
			padding: 3rem;
		}
	}
</style>

