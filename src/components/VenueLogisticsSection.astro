---
import type { VenueLogisticsSection } from '../lib/content';
import Icon from "astro-icon";

interface Props {
	content: VenueLogisticsSection;
}

const { content } = Astro.props;

---

<section class="venue-logistics">

  <!-- Header -->
  <header class="vl-header">
    <h1 data-logistics-title>{content.title}</h1>
    <p data-logistics-intro>{content.intro}</p>
  </header>

  <!-- Public Transport -->
  <div class="vl-section">
    <div class="vl-section-header">
      <!-- <img src="/icons/bus.svg" class="vl-icon" alt="" /> -->
      <span name="lucide:bus" class="vl-icon" />
      <h2 data-logistics-vl-section-publicTransport-title>{content.publicTransport.title}</h2>
    
    </div>

    <ul data-logistics-vl-section-publicTransport-bullets>
      {content.publicTransport.bullets.map((b) => <li>{b}</li>)}
    </ul>
    <div data-logistics-vl-section-publicTransport-externalLink></div>
   
    
  </div>

  <!-- Parking -->
  <div class="vl-section">
    <div class="vl-section-header">
      <!-- <img src="/icons/parking.svg" class="vl-icon" alt="" /> -->
      <span name="lucide:parking-circle" class="vl-icon" />
      <h2 data-logistics-vl-section-parking-title>{content.parking.title}</h2>
    </div>

    <ul data-logistics-vl-section-parking-bullets>
      {content.parking.bullets.map((b) => <li>{b}</li>)}
    </ul>
    <div data-logistics-vl-section-parking-externalLink></div>
 
  </div>

  <!-- Accessibility -->
  <div class="vl-section">
    <div class="vl-section-header">
      <!-- <img src="/icons/wheelchair.svg" class="vl-icon" alt="" /> -->
      <span name="lucide:wheelchair" class="vl-icon" />
      <h2 data-logistics-vl-section-Accessibility-title>{content.accessibility.title}</h2>
    </div>

    
    <ul data-logistics-vl-section-Accessibility-bullets>
      {content.accessibility.bullets.map((b) => <li>{b}</li>)}
    </ul>
  <div  data-logistics-vl-section-Accessibility-externalLink></div>
  </div>

  <!-- Getting Here -->
  <div class="vl-section">
    <div class="vl-section-header">
      <!-- <img src="/icons/location.svg" class="vl-icon" alt="" /> -->
      <span name="lucide:map-pin" class="vl-icon" />
      
      <h2 data-logistics-gettingHere-title>{content.gettingHere.title}</h2>
    </div>

    <ul data-logistics-gettingHere-bullets >
      {content.gettingHere.bullets.map((b) => <li>{b}</li>)}
    </ul>

	<div data-logistics-vl-section-gettingHere-externalLink></div>
   

    {content.gettingHere.mapEmbedUrl && (
      <iframe
        class="vl-map"
        src={content.gettingHere.mapEmbedUrl}
        loading="lazy"
      ></iframe>
    )}
  </div>

</section>

<style>
  .venue-logistics {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    padding: 2rem 0;
  }

  .vl-header h1 {
    font-size: 2rem;
    margin-bottom: 0.5rem;
  }

  .vl-section-header {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.5rem;
  }

  .vl-icon {
    width: 24px;
    height: 24px;
    object-fit: contain;
  }

  .vl-section ul {
    margin: 0;
    padding-left: 1.2rem;
  }

  .vl-section li {
    margin-bottom: 0.4rem;
  }

  .vl-link {
    display: block;
    margin-top: 0.4rem;
    color: #0077ff;
    font-weight: 500;
  }

  .vl-map {
    width: 100%;
    height: 300px;
    border: 0;
    margin-top: 1rem;
    border-radius: 8px;
  }
</style>

<script>
	import { getCityStore } from "../lib/cityStore";
	import { getVenueLogistics, type City } from "../lib/content";
	const logisticsTitle = document.querySelector("[data-logistics-title]");
	const logisticsIntro = document.querySelector("[data-logistics-intro]");
	const logisticsGettingHereTitle = document.querySelector("[data-logistics-gettingHere-title]");
	const logisticsGettingHereBullets = document.querySelector("[data-logistics-gettingHere-bullets]");
	const logisticsVlSectionGettingHereExternalLink = document.querySelector("[data-logistics-vl-section-gettingHere-externalLink]");
	const logisticsVlSectionPublicTransportTitle = document.querySelector("[data-logistics-vl-section-publicTransport-title]");
	const logisticsVlSectionPublicTransportBullets = document.querySelector("[data-logistics-vl-section-publicTransport-bullets]");
	const logisticsVlSectionPublicTransportExternalLink = document.querySelector("[data-logistics-vl-section-publicTransport-externalLink]");
	const logisticsVlSectionParkingTitle = document.querySelector("[data-logistics-vl-section-parking-title]");
	const logisticsVlSectionParkingBullets = document.querySelector("[data-logistics-vl-section-parking-bullets]");
	const logisticsVlsectionParkingExternalLink = document.querySelector("[data-logistics-vl-section-parking-externalLink]");
	const logisticsVlSectionAccessibilityTitle = document.querySelector("[data-logistics-vl-section-Accessibility-title]");
	const logisticsVlSectionAccessibilityBullets = document.querySelector("[data-logistics-vl-section-Accessibility-bullets]");
	const logisticsvlSectionAccessibilityExternalLink = document.querySelector("[data-logistics-vl-section-Accessibility-externalLink]");

	


	// Run when DOM is ready
	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initCityAwareNav);
	} else {
		initCityAwareNav();
	}


function renderSectionBullets(sectionName, bullets) {

  const el = document.querySelector(sectionName);
  if (!el) return;
  el.innerHTML = '';

  if (!bullets) return;
  if (!Array.isArray(bullets)) return;

  el.innerHTML = bullets
    .map((b) => `<li>${b}</li>`)
    .join("");
}

export function renderLink(selector, links) {
  debugger;
  const el = document.querySelector(selector);
  if (!el) return;
  el.innerHTML = '';

  if (!links) return;
  if (!Array.isArray(links)) return;

  el.innerHTML = links
    .map((b) => `<a href="${b.url}" target="_blank" rel="noopener noreferrer">${b.text}</a>`)
    .join("</br>");
}


	function updateVenueLogistics() {
		const cityStore = getCityStore();
		const currentCity = cityStore.getCity();
		const content = getVenueLogistics(currentCity);		

		if (logisticsTitle) logisticsTitle.textContent = content.title;
		if (logisticsIntro) logisticsIntro.textContent = content.intro;
		if (logisticsGettingHereTitle) logisticsGettingHereTitle.textContent = content.gettingHere.title;    
		if (logisticsGettingHereBullets)
		renderSectionBullets("[data-logistics-gettingHere-bullets]",content.gettingHere.bullets);
		console.table(content.gettingHere.externalLink);
		if (logisticsVlSectionGettingHereExternalLink) 
		renderLink("[data-logistics-vl-section-gettingHere-externalLink]",content.gettingHere.externalLink);
		if (logisticsVlSectionPublicTransportTitle) logisticsVlSectionPublicTransportTitle.textContent = content.publicTransport.title;
		if (logisticsVlSectionPublicTransportBullets)
		renderSectionBullets("[data-logistics-vl-section-publicTransport-bullets]",content.publicTransport.bullets);

		console.table(content.publicTransport.externalLink);
		if (logisticsVlSectionPublicTransportExternalLink) 
		renderLink("[data-logistics-vl-section-publicTransport-externalLink]",content.publicTransport.externalLink);
		if (logisticsVlSectionParkingTitle) logisticsVlSectionParkingTitle.textContent = content.parking.title;
		if (logisticsVlSectionParkingBullets)
		renderSectionBullets("[data-logistics-vl-section-parking-bullets]",content.parking.bullets);
	
    console.table(content.parking.externalLink);
		if (logisticsVlsectionParkingExternalLink) 
		renderLink("[data-logistics-vl-section-parking-externalLink]",content.parking.externalLink);
		if (logisticsVlSectionAccessibilityTitle) logisticsVlSectionAccessibilityTitle.textContent = content.accessibility.title;
		if (logisticsVlSectionAccessibilityBullets)
		renderSectionBullets("[data-logistics-vl-section-Accessibility-bullets]",content.accessibility.bullets);
	
    console.table(content.accessibility.externalLink);
		if (logisticsvlSectionAccessibilityExternalLink) 
		renderLink("[data-logistics-vl-section-Accessibility-externalLink]",content.accessibility.externalLink);
		
	}

	function initCityAwareNav() {
		const cityStore = getCityStore();
		cityStore.init();
	
		// Update ticket URL on initial load
		updateVenueLogistics();

		// Subscribe to city changes
		cityStore.subscribe((city: City) => {
			updateVenueLogistics();
		});
	}


</script>
