---
import { communityPartners } from "../lib/content"

const withBase = (path: string) => {
    const base = import.meta.env.BASE_URL ?? '/';
    const normalizedBase = base.endsWith('/') ? base : `${base}/`;
    const normalizedPath = path.startsWith('/') ? path.slice(1) : path;
    return `${normalizedBase}${normalizedPath}`;
};
---

<section class="community-partners">
    <h2 class="community-partners-heading">
        <span class="community-partners-prefix">Community </span>
        Partners
    </h2>
    <div class="community-partners-card">
        <div id="partners-container">
            {communityPartners.map((partner) => {
                return (
                    <figure class="partner">
                        <a
                            class="partner-link"
                            href={partner.url}
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label={`Visit ${partner.name} website`}
                        >
                            <img class="partner-logo" src={withBase(partner.logo)} alt={partner.name} />
                        </a>
                    </figure>
                );
            })}
        </div>
    </div>
</section>

<style>
    .community-partners {
        text-align: center;
        max-width: 1200px;
        margin: 2.5rem auto 2.5rem;
        padding: 0;
    }

    .community-partners-card {
        background: rgba(61, 120, 171, 0.1);
        border: 1px solid rgba(61, 120, 171, 0.2);
        border-radius: 1rem;
        overflow: hidden;
        padding: 2rem 1.5rem 3rem;
    }
    .community-partners-heading {
        font-family: 'Squada One', system-ui, sans-serif;
		font-size: 2.5rem;
		font-weight: 400;
		margin: 0 0 1rem 0;
		line-height: 1.2;
		letter-spacing: 0.02em;
		color: rgb(251, 113, 133);
    }

    .community-partners-prefix {
        color: white;
        font-family: 'Squada One', system-ui, sans-serif;
        font-size: 2.5rem;
        font-weight: 400;
        letter-spacing: 0.02em;
    }

    @media (min-width: 769px) {
        .community-partners {
            margin: 4rem auto;
        }

        .community-partners-card {
            padding: 4.5rem 2rem 4rem;
        }

        .community-partners-heading {
            font-size: 4rem;
        }

        .community-partners-prefix {
            font-size: 4rem;
        }
    }
    .partner {
        flex: 0 0 calc(20% - 1.6rem);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0;
        min-width: 160px;
        max-width: 220px;
    }
    .partner-logo {
        max-width: 100%;
        height: 90px;
        width: auto;
        object-fit: contain;
        display: block;
    }
    .partner-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 0.5rem;
        outline: none;
        -webkit-tap-highlight-color: transparent;
    }
    .partner-link:focus-visible {
        box-shadow: 0 0 0 3px rgba(168, 251, 90, 0.45);
    }

    /* Desktop: 5 logos per row, centered rows (including last row) */
    #partners-container {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        align-items: center;
        gap: 2.25rem 2rem;
        padding: 0.5rem 0;
    }

    /* Mobile: 2-column grid, no sideways scroll; last partner centered on its own row */
    @media (max-width: 768px) {
        .community-partners {
            padding: 0 1rem;
            margin-bottom: 2rem;
        }

        .community-partners-card {
            padding: 1.5rem 1rem 2rem;
        }

        .community-partners-heading,
        .community-partners-prefix {
            font-size: 2rem;
        }

        /* Mobile: 3 per row, last row centered */
        #partners-container {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            align-items: center;
            gap: 1.5rem 1rem;
            padding: 0.35rem 0 0.15rem;
        }

        .partner {
            flex: 0 0 calc(33.333% - 0.75rem);
            min-height: 4.5rem;
            min-width: 0;
            max-width: 180px;
        }

        .partner-logo {
            max-width: 100%;
            max-height: 72px;
            height: auto;
            width: auto;
            margin-inline: auto;
        }
    }
</style>