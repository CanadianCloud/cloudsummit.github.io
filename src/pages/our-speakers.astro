---
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import ScrollAnimations from '../components/ScrollAnimations.astro';
import { navigationContent, footerContent, speakerContent } from '../lib/content';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import SeoSocial from '../components/SeoSocial.astro';
import { absoluteUrl, DEFAULT_OG_IMAGE_PATH, getCanonical } from '../lib/seo';

const pageTitle = 'Our Speakers - Cloud Summit 2026';
const pageDescription =
	"Meet Cloud Summit 2026 featured speakers at Canada's premier multi-cloud conference in Vancouver and Toronto.";
const canonicalUrl = getCanonical(Astro);
const ogImageUrl = absoluteUrl(DEFAULT_OG_IMAGE_PATH, Astro);

---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={pageDescription} />
		<SeoSocial
			title={pageTitle}
			description={pageDescription}
			canonicalUrl={canonicalUrl}
			ogImageUrl={ogImageUrl}
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Squada+One&family=Noto+Sans:wght@400;500;600;700&family=Doto:wght@100..900&display=swap" rel="stylesheet" />
		<title>{pageTitle}</title>
		<GoogleAnalytics />
	</head>
	<body>
		<script is:inline>
			(function () {
				try {
					var c = new URLSearchParams(window.location.search).get('city');
					document.body.setAttribute(
						'data-speakers-city',
						c === 'toronto' ? 'toronto' : 'vancouver',
					);
				} catch (e) {
					document.body.setAttribute('data-speakers-city', 'vancouver');
				}
			})();
		</script>
		<Navigation content={navigationContent} />

		<main class="speakers-page">
			<!-- Hero Section -->
			<section class="speakers-hero">
				<div class="pulsing-squares">
					<div class="square" style="left: 10%; top: 15%;"></div>
					<div class="square" style="left: 25%; top: 25%;"></div>
					<div class="square" style="left: 40%; top: 18%;"></div>
					<div class="square" style="left: 55%; top: 30%;"></div>
					<div class="square" style="left: 70%; top: 22%;"></div>
					<div class="square" style="left: 85%; top: 35%;"></div>
					<div class="square" style="left: 15%; top: 45%;"></div>
					<div class="square" style="left: 35%; top: 50%;"></div>
					<div class="square" style="left: 50%; top: 13%;"></div>
					<div class="square" style="left: 65%; top: 55%;"></div>
					<div class="square" style="left: 80%; top: 48%;"></div>
					<div class="square" style="left: 20%; top: 60%;"></div>
					<div class="square" style="left: 45%; top: 65%;"></div>
					<div class="square" style="left: 75%; top: 70%;"></div>
					<div class="square" style="left: 30%; top: 75%;"></div>
				</div>
				<div class="hero-container">
					<h1 class="hero-title">Our Speakers</h1>
				</div>
			</section>

			<!-- Speakers: Vancouver lineup vs Toronto coming soon (synced with navbar city) -->
			<section class="speakers-section">
				<div class="speakers-container">
					<div class="speakers-city-content speakers-city-content--toronto" aria-live="polite">
						<p class="speakers-coming-soon">Coming soon..</p>
					</div>
					<div class="speakers-city-content speakers-city-content--vancouver">
					<div class="speakers-grid speakers-grid--detailed">
						{speakerContent.filter((speaker) => !speaker.hidden).map((speaker, index) => {
							const bioDialogId = `speaker-bio-dialog-${index}`;
							const bioTitleId = `${bioDialogId}-title`;
							return (
								<article class="speaker-card speaker-card--detailed">
									<div class="speaker-image">
										<img src={speaker.image} alt={speaker.speakername} loading="lazy" />
									</div>
									<div class="speaker-info">
										<h3 class="speaker-name">{speaker.speakername}</h3>
										{speaker.title && <p class="speaker-title">{speaker.title}</p>}
										{speaker.linkedin && (
											<p class="speaker-linkedin">
												<a
													href={speaker.linkedin}
													target="_blank"
													rel="noopener noreferrer"
												>
													LinkedIn
												</a>
											</p>
										)}
										{(speaker.talkTitle || speaker.talkLevel) && (
											<div class="speaker-talk-block">
												{speaker.talkTitle && (
													<p class="speaker-talk-headline">{speaker.talkTitle}</p>
												)}
												{speaker.talkLevel && (
													<p class="speaker-talk-level-tag">{speaker.talkLevel}</p>
												)}
											</div>
										)}
										{speaker.company && <p class="speaker-company">{speaker.company}</p>}
										{speaker.topic && <p class="speaker-topic">{speaker.topic}</p>}
										{(speaker.bio || speaker.talkSummary) && (
											<>
												<button
													type="button"
													class="speaker-see-more-btn"
													data-speaker-dialog={bioDialogId}
												>
													See more
												</button>
												<dialog
													id={bioDialogId}
													class="speaker-bio-dialog"
													aria-labelledby={bioTitleId}
												>
													<div class="speaker-bio-dialog__panel">
														<header class="speaker-bio-dialog__header">
															<h2 id={bioTitleId} class="speaker-bio-dialog__title">
																{speaker.speakername}
															</h2>
															<button
																type="button"
																class="speaker-bio-dialog__close"
																aria-label="Close dialog"
															>
																×
															</button>
														</header>
														<div class="speaker-bio-dialog__body">
															{speaker.bio && (
																<div class="speaker-bio-dialog__block">
																	<h3 class="speaker-bio-dialog__section-label">Bio</h3>
																	<p class="speaker-bio-dialog__text">{speaker.bio}</p>
																</div>
															)}
															{speaker.talkSummary && (
																<div class="speaker-bio-dialog__block">
																	<h3 class="speaker-bio-dialog__section-label">
																		Talk summary
																	</h3>
																	<p class="speaker-bio-dialog__text">{speaker.talkSummary}</p>
																</div>
															)}
														</div>
													</div>
												</dialog>
											</>
										)}
									</div>
								</article>
							);
						})}
					</div>
					</div>
				</div>
			</section>
		</main>

		<Footer content={footerContent} />
		<ScrollAnimations />

		<script>
			import { getCityStore } from '../lib/cityStore';
			import type { City } from '../lib/content';

			function syncSpeakersPageCity(city: City) {
				document.body.setAttribute('data-speakers-city', city);
			}

			function initSpeakersPageCity() {
				const cityStore = getCityStore();
				cityStore.init();
				syncSpeakersPageCity(cityStore.getCity());
				cityStore.subscribe(syncSpeakersPageCity);
			}

			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', initSpeakersPageCity);
			} else {
				initSpeakersPageCity();
			}

			function initSpeakerBioDialogs() {
				document.querySelectorAll('.speaker-see-more-btn').forEach((btn) => {
					btn.addEventListener('click', () => {
						const id = btn.getAttribute('data-speaker-dialog');
						const el = id ? document.getElementById(id) : null;
						if (el instanceof HTMLDialogElement) el.showModal();
					});
				});
				document.querySelectorAll('dialog.speaker-bio-dialog').forEach((node) => {
					if (!(node instanceof HTMLDialogElement)) return;
					node.addEventListener('click', (e) => {
						if (e.target === node) node.close();
					});
					node.querySelectorAll('.speaker-bio-dialog__close').forEach((closeBtn) => {
						closeBtn.addEventListener('click', () => node.close());
					});
				});
			}

			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', initSpeakerBioDialogs);
			} else {
				initSpeakerBioDialogs();
			}
		</script>
	</body>
</html>

<style is:global>
	* {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}

	html {
		font-family: 'Noto Sans', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
		line-height: 1.6;
		color: #1a1a1a;
	}

	h1, h2, h3, h4, h5, h6 {
		font-family: 'Squada One', system-ui, sans-serif;
		font-weight: 400;
		letter-spacing: 0.02em;
	}

	body {
		min-height: 100vh;
		background: black;
		color: white;
	}
</style>

<style>
	.speakers-page {
		background: black;
		color: white;
	}

	/* Hero Section */
	.speakers-hero {
		padding: 6rem 1.5rem 1.25rem;
		background: black;
		position: relative;
		overflow: hidden;
	}

	.pulsing-squares {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		pointer-events: none;
		z-index: 0;
	}

	.square {
		position: absolute;
		width: 15px;
		height: 15px;
		background: rgb(251, 113, 133);
		animation: pulse 2s ease-in-out infinite;
	}

	/* Varied opacity for depth */
	.square:nth-child(1) { animation-delay: 0s; opacity: 0.4; }
	.square:nth-child(2) { animation-delay: 0.3s; opacity: 0.38; }
	.square:nth-child(3) { animation-delay: 0.6s; opacity: 0.4; }
	.square:nth-child(4) { animation-delay: 0.9s; opacity: 0.32; }
	.square:nth-child(5) { animation-delay: 1.2s; opacity: 0.38; }
	.square:nth-child(6) { animation-delay: 1.5s; opacity: 0.3; }
	.square:nth-child(7) { animation-delay: 0.4s; opacity: 0.28; }
	.square:nth-child(8) { animation-delay: 0.8s; opacity: 0.25; }
	.square:nth-child(9) { animation-delay: 0.2s; opacity: 0.45; }
	.square:nth-child(10) { animation-delay: 1.1s; opacity: 0.22; }
	.square:nth-child(11) { animation-delay: 1.4s; opacity: 0.25; }
	.square:nth-child(12) { animation-delay: 0.5s; opacity: 0.2; }
	.square:nth-child(13) { animation-delay: 1.0s; opacity: 0.18; }
	.square:nth-child(14) { animation-delay: 1.3s; opacity: 0.15; }
	.square:nth-child(15) { animation-delay: 0.7s; opacity: 0.18; }

	@keyframes pulse {
		0%, 100% {
			transform: scale(1);
		}
		50% {
			transform: scale(1.3);
		}
	}

	.hero-container {
		max-width: 900px;
		margin: 0 auto;
		text-align: center;
		position: relative;
		z-index: 1;
	}

	.hero-title {
		font-family: 'Squada One', system-ui, sans-serif;
		font-size: 3rem;
		margin: 0;
		color: rgb(251, 113, 133);
	}

	.hero-subtitle {
		font-size: 1.5rem;
		margin: 0 0 1.5rem 0;
		color: white;
	}

	.hero-description {
		font-size: 1.125rem;
		line-height: 1.8;
		opacity: 0.9;
	}

	/* Speakers Section */
	.speakers-section {
		padding: 1.25rem 1.5rem 4rem;
	}

	.speakers-container {
		max-width: 1200px;
		margin: 0 auto;
	}

	/* Toronto: show “Coming soon..” (white); Vancouver: show speaker grid */
	.speakers-city-content--toronto {
		display: none;
		padding: 2rem 0 3rem;
		text-align: center;
	}

	body[data-speakers-city='toronto'] .speakers-city-content--vancouver {
		display: none;
	}

	body[data-speakers-city='toronto'] .speakers-city-content--toronto {
		display: block;
	}

	.speakers-coming-soon {
		font-family: 'Squada One', system-ui, sans-serif;
		font-size: 2.25rem;
		font-weight: 400;
		letter-spacing: 0.02em;
		color: #ffffff;
		margin: 0;
		line-height: 1.3;
	}

	.speakers-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 2rem;
	}

	@media (min-width: 900px) {
		.speakers-grid--detailed {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			align-items: stretch;
		}
	}

	.speakers-grid--detailed {
		gap: 2.5rem;
		align-items: stretch;
	}

	.speaker-card {
		background: rgba(61, 120, 171, 0.1);
		border: 1px solid rgba(61, 120, 171, 0.2);
		border-radius: 1rem;
		padding: 2rem;
		text-align: center;
		transition: transform 0.2s, border-color 0.2s;
	}

	.speaker-card--detailed {
		display: flex;
		flex-direction: column;
		align-items: stretch;
		gap: 1.5rem;
		text-align: left;
		height: 100%;
		min-height: 380px;
	}

	.speaker-card:hover {
		transform: translateY(-4px);
		border-color: rgba(61, 120, 171, 0.4);
	}

	.speaker-card--detailed .speaker-image {
		margin: 0 auto;
		flex-shrink: 0;
	}

	.speaker-image {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		max-width: 260px;
		min-height: 200px;
		margin: 0 auto 1.25rem;
		border-radius: 1rem;
		overflow: hidden;
		border: 2px solid rgba(251, 113, 133, 0.6);
		background: rgba(255, 255, 255, 0.04);
	}

	.speaker-image img {
		width: auto;
		max-width: 100%;
		height: auto;
		max-height: 240px;
		object-fit: contain;
		object-position: center center;
		display: block;
	}

	.speaker-info {
		text-align: center;
	}

	.speaker-card--detailed .speaker-info {
		text-align: left;
		min-width: 0;
	}

	/* Mobile: photo left, text right */
	@media (max-width: 768px) {
		.speaker-card--detailed {
			flex-direction: row;
			align-items: flex-start;
			gap: 1rem;
			padding: 1.25rem 1rem;
			min-height: 220px;
		}

		.speaker-card--detailed .speaker-image {
			margin: 0;
			width: 42%;
			max-width: 140px;
			min-height: 0;
			min-width: 0;
			flex-shrink: 0;
		}

		.speaker-card--detailed .speaker-image img {
			max-height: 160px;
		}

		.speaker-card--detailed .speaker-info {
			text-align: left;
			flex: 1;
		}

		.speaker-name {
			font-size: 1.25rem;
			line-height: 1.2;
		}

		.speaker-linkedin {
			margin-top: 0.5rem;
		}

		.speaker-talk-headline {
			font-size: 1rem;
		}

		.speaker-talk-headline[data-astro-cid-k3qul66j] {
			font-size: 1rem;
		}
	}

	.speaker-name {
		font-family: 'Squada One', system-ui, sans-serif;
		font-size: 1.5rem;
		margin: 0 0 0.5rem 0;
		color: white;
	}

	.speaker-title {
		font-size: 1rem;
		margin: 0 0 0.25rem 0;
		font-weight: 600;
		color: rgb(251, 113, 133);
	}

	.speaker-company {
		font-size: 0.875rem;
		margin: 0 0 0.75rem 0;
		opacity: 0.8;
	}

	.speaker-topic {
		font-size: 0.875rem;
		margin: 0;
		opacity: 0.7;
		font-style: italic;
	}

	.speaker-talk-block {
		margin: 1rem 0 0 0;
	}

	.speaker-linkedin {
		margin: 0.75rem 0 0 0;
		font-size: 1rem;
		font-weight: 600;
	}

	.speaker-linkedin a {
		color: rgb(113, 198, 251);
		text-decoration: none;
	}

	.speaker-linkedin a:hover {
		text-decoration: underline;
	}

	.speaker-talk-headline {
		margin: 0 0 0.5rem 0;
		font-size: 1.125rem;
		font-weight: 600;
		line-height: 1.4;
		color: white;
	}

	.speaker-talk-level-tag {
		margin: 0;
		font-size: 0.8125rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		opacity: 0.85;
	}

	.speaker-see-more-btn {
		margin-top: 1.25rem;
		padding: 0.6rem 1.25rem;
		font-family: 'Noto Sans', system-ui, sans-serif;
		font-size: 0.9375rem;
		font-weight: 600;
		color: #fff;
		background: rgba(61, 120, 171, 0.35);
		border: 1px solid rgba(61, 120, 171, 0.55);
		border-radius: 0.5rem;
		cursor: pointer;
		transition: background 0.2s, border-color 0.2s, transform 0.15s;
	}

	.speaker-see-more-btn:hover {
		background: rgba(61, 120, 171, 0.55);
		border-color: rgba(251, 113, 133, 0.5);
	}

	.speaker-see-more-btn:focus {
		outline: none;
		box-shadow: 0 0 0 3px rgba(251, 113, 133, 0.35);
	}

	.speaker-bio-dialog {
		position: fixed;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		margin: 0;
		width: min(36rem, calc(100vw - 2rem));
		max-width: min(36rem, calc(100vw - 2rem));
		max-height: min(85vh, 40rem);
		padding: 0;
		border: 1px solid rgba(61, 120, 171, 0.45);
		border-radius: 1rem;
		background: #0a0a0a;
		color: #fff;
		box-shadow: 0 1rem 2.5rem rgba(0, 0, 0, 0.55);
	}

	.speaker-bio-dialog::backdrop {
		background: rgba(0, 0, 0, 0.72);
		backdrop-filter: blur(4px);
	}

	.speaker-bio-dialog__header {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem;
		padding: 1.25rem 1.25rem 0.75rem;
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
	}

	.speaker-bio-dialog__title {
		font-family: 'Squada One', system-ui, sans-serif;
		font-size: 1.5rem;
		font-weight: 400;
		margin: 0;
		line-height: 1.2;
		color: rgb(251, 113, 133);
		letter-spacing: 0.02em;
	}

	.speaker-bio-dialog__close {
		flex-shrink: 0;
		width: 2.25rem;
		height: 2.25rem;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 0;
		font-size: 1.5rem;
		line-height: 1;
		color: rgba(255, 255, 255, 0.85);
		background: rgba(255, 255, 255, 0.08);
		border: none;
		border-radius: 0.375rem;
		cursor: pointer;
		transition: background 0.2s, color 0.2s;
	}

	.speaker-bio-dialog__close:hover {
		background: rgba(255, 255, 255, 0.14);
		color: #fff;
	}

	.speaker-bio-dialog__body {
		padding: 1rem 1.25rem 1.5rem;
		max-height: min(60vh, 28rem);
		overflow-y: auto;
	}

	.speaker-bio-dialog__block + .speaker-bio-dialog__block {
		margin-top: 1.5rem;
		padding-top: 1.25rem;
		border-top: 1px solid rgba(255, 255, 255, 0.1);
	}

	.speaker-bio-dialog__section-label {
		font-family: 'Squada One', system-ui, sans-serif;
		font-size: 1.125rem;
		font-weight: 400;
		margin: 0 0 0.5rem 0;
		color: rgb(255, 193, 77);
		letter-spacing: 0.02em;
	}

	.speaker-bio-dialog__text {
		margin: 0;
		font-size: 1rem;
		line-height: 1.65;
		opacity: 0.92;
	}

	/* Desktop Styles */
	@media (min-width: 769px) {
		.speakers-hero {
			padding: 6rem 2rem 1.5rem;
		}

		.hero-title {
			font-size: 4.5rem;
		}

		.hero-subtitle {
			font-size: 2rem;
		}

		.hero-description {
			font-size: 1.25rem;
		}

		.speakers-section {
			padding: 1.5rem 2rem 6rem;
		}

		.speakers-coming-soon {
			font-size: 3rem;
		}

		.speakers-grid--detailed {
			gap: 3rem;
		}

		.speaker-card--detailed {
			flex-direction: row;
			align-items: flex-start;
			gap: 2.5rem;
			padding: 2.25rem 2.5rem;
			min-height: 420px;
		}

		.speaker-card--detailed .speaker-image {
			margin: 0;
			max-width: 240px;
			min-height: 220px;
		}

		.speaker-card--detailed .speaker-image img {
			max-height: 260px;
		}

		.speaker-image {
			max-width: 280px;
			min-height: 260px;
		}

		.speaker-image img {
			max-height: 280px;
		}
	}
</style>
