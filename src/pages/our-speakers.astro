---
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import ScrollAnimations from '../components/ScrollAnimations.astro';
import { navigationContent, footerContent, citySpecificContent, speakerContent } from '../lib/content';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import SeoSocial from '../components/SeoSocial.astro';
import { absoluteUrl, DEFAULT_OG_IMAGE_PATH, getCanonical } from '../lib/seo';

const pageTitle = 'Call for Speakers - Cloud Summit 2026';
const pageDescription =
	"Meet Cloud Summit 2026 featured speakers and submit your talk for Canada's premier multi-cloud conference in Vancouver and Toronto.";
const canonicalUrl = getCanonical(Astro);
const ogImageUrl = absoluteUrl(DEFAULT_OG_IMAGE_PATH, Astro);

---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={pageDescription} />
		<SeoSocial
			title={pageTitle}
			description={pageDescription}
			canonicalUrl={canonicalUrl}
			ogImageUrl={ogImageUrl}
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Squada+One&family=Noto+Sans:wght@400;500;600;700&family=Doto:wght@100..900&display=swap" rel="stylesheet" />
		<title>{pageTitle}</title>
		<GoogleAnalytics />
	</head>
	<body>
		<Navigation content={navigationContent} />

		<main class="speakers-page">
			<!-- Hero Section -->
			<section class="speakers-hero">
				<div class="pulsing-squares">
					<div class="square" style="left: 10%; top: 15%;"></div>
					<div class="square" style="left: 25%; top: 25%;"></div>
					<div class="square" style="left: 40%; top: 18%;"></div>
					<div class="square" style="left: 55%; top: 30%;"></div>
					<div class="square" style="left: 70%; top: 22%;"></div>
					<div class="square" style="left: 85%; top: 35%;"></div>
					<div class="square" style="left: 15%; top: 45%;"></div>
					<div class="square" style="left: 35%; top: 50%;"></div>
					<div class="square" style="left: 50%; top: 13%;"></div>
					<div class="square" style="left: 65%; top: 55%;"></div>
					<div class="square" style="left: 80%; top: 48%;"></div>
					<div class="square" style="left: 20%; top: 60%;"></div>
					<div class="square" style="left: 45%; top: 65%;"></div>
					<div class="square" style="left: 75%; top: 70%;"></div>
					<div class="square" style="left: 30%; top: 75%;"></div>
				</div>
				<div class="hero-container">
					<h1 class="hero-title">Our Speakers</h1>
				</div>
			</section>

			<!-- Speakers Grid -->
			<section class="speakers-section">
				<div class="speakers-container">
					<div class="speakers-grid speakers-grid--detailed">
						{speakerContent.map((speaker) => (
							<article class="speaker-card speaker-card--detailed">
								<div class="speaker-image">
									<img src={speaker.image} alt={speaker.speakername} loading="lazy" />
								</div>
								<div class="speaker-info">
									<h3 class="speaker-name">{speaker.speakername}</h3>
									{speaker.linkedin && (
										<p class="speaker-linkedin">
											<a
												href={speaker.linkedin}
												target="_blank"
												rel="noopener noreferrer"
											>
												LinkedIn
											</a>
										</p>
									)}
									{speaker.bio && (
										<>
											<h4 class="speaker-detail-heading">Bio</h4>
											<p class="speaker-bio">{speaker.bio}</p>
										</>
									)}
									{speaker.talkTitle && (
										<>
											<h4 class="speaker-detail-heading">Talk</h4>
											<p class="speaker-talk-headline">{speaker.talkTitle}</p>
											{speaker.talkLevel && (
												<p class="speaker-talk-level-tag">{speaker.talkLevel}</p>
											)}
										</>
									)}
									{speaker.title && <p class="speaker-title">{speaker.title}</p>}
									{speaker.company && <p class="speaker-company">{speaker.company}</p>}
									{speaker.topic && <p class="speaker-topic">{speaker.topic}</p>}
								</div>
							</article>
						))}
					</div>
				</div>
			</section>

			<!-- Call for Speakers -->
			<section class="cfs-section" id="speakers">
				<div class="cfs-container">
					<h2 class="section-heading">
						<span class="heading-prefix">Become a </span>
						Speaker
					</h2>
					<p class="cfs-description">
						Are you a cloud expert with insights to share? We're looking for passionate speakers
						to present at Cloud Summit 2026. Share your knowledge with hundreds of cloud professionals
						and help shape the future of cloud computing in Canada.
					</p>
					<div class="cfs-dates">
						<div class="cfs-date-card">
							<h3>Vancouver</h3>
							<p class="date-label">Call for Speakers Opens</p>
							<p class="date-value">{citySpecificContent.vancouver.callForSpeakers}</p>
						</div>
						<div class="cfs-date-card">
							<h3>Toronto</h3>
							<p class="date-label">Call for Speakers Opens</p>
							<p class="date-value">{citySpecificContent.toronto.callForSpeakers}</p>
						</div>
					</div>
					<div class="cfs-benefits">
						<div class="benefit-item">
							<h3>Share Your Expertise</h3>
							<p>Present your knowledge to 1,000+ cloud professionals</p>
						</div>
						<div class="benefit-item">
							<h3>Build Your Brand</h3>
							<p>Establish yourself as a thought leader in the cloud community</p>
						</div>
						<div class="benefit-item">
							<h3>Network & Connect</h3>
							<p>Meet fellow experts and expand your professional network</p>
						</div>
						<div class="benefit-item">
							<h3>Get Recorded</h3>
							<p>Main stage talks are professionally recorded and published</p>
						</div>
					</div>
				</div>
			</section>

			<!-- Speaking Opportunities -->
			<section class="opportunities-section">
				<div class="opportunities-container">
					<h2 class="section-heading">
						<span class="heading-prefix">Speaking </span>
						Formats
					</h2>
					<div class="opportunities-grid">
						<div class="opportunity-card">
							<h3>Keynote</h3>
							<p class="duration">45 minutes</p>
							<p>Main stage presentation for industry leaders and major announcements</p>
						</div>
						<div class="opportunity-card">
							<h3>Workshop</h3>
							<p class="duration">90 minutes</p>
							<p>Hands-on, interactive sessions for deep-dive technical training</p>
						</div>
						<div class="opportunity-card">
							<h3>Technical Talk</h3>
							<p class="duration">30 minutes</p>
							<p>In-depth presentations on specific cloud technologies and practices</p>
						</div>
						<div class="opportunity-card">
							<h3>Lightning Talk</h3>
							<p class="duration">10 minutes</p>
							<p>Quick, focused presentations on specific topics or use cases</p>
						</div>
					</div>
				</div>
			</section>
		</main>

		<Footer content={footerContent} />
		<ScrollAnimations />
	</body>
</html>

<style is:global>
	* {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}

	html {
		font-family: 'Noto Sans', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
		line-height: 1.6;
		color: #1a1a1a;
	}

	h1, h2, h3, h4, h5, h6 {
		font-family: 'Squada One', system-ui, sans-serif;
		font-weight: 400;
		letter-spacing: 0.02em;
	}

	body {
		min-height: 100vh;
		background: black;
		color: white;
	}
</style>

<style>
	.speakers-page {
		background: black;
		color: white;
	}

	/* Hero Section */
	.speakers-hero {
		padding: 6rem 1.5rem 1.25rem;
		background: black;
		position: relative;
		overflow: hidden;
	}

	.pulsing-squares {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		pointer-events: none;
		z-index: 0;
	}

	.square {
		position: absolute;
		width: 15px;
		height: 15px;
		background: rgb(251, 113, 133);
		animation: pulse 2s ease-in-out infinite;
	}

	/* Varied opacity for depth */
	.square:nth-child(1) { animation-delay: 0s; opacity: 0.4; }
	.square:nth-child(2) { animation-delay: 0.3s; opacity: 0.38; }
	.square:nth-child(3) { animation-delay: 0.6s; opacity: 0.4; }
	.square:nth-child(4) { animation-delay: 0.9s; opacity: 0.32; }
	.square:nth-child(5) { animation-delay: 1.2s; opacity: 0.38; }
	.square:nth-child(6) { animation-delay: 1.5s; opacity: 0.3; }
	.square:nth-child(7) { animation-delay: 0.4s; opacity: 0.28; }
	.square:nth-child(8) { animation-delay: 0.8s; opacity: 0.25; }
	.square:nth-child(9) { animation-delay: 0.2s; opacity: 0.45; }
	.square:nth-child(10) { animation-delay: 1.1s; opacity: 0.22; }
	.square:nth-child(11) { animation-delay: 1.4s; opacity: 0.25; }
	.square:nth-child(12) { animation-delay: 0.5s; opacity: 0.2; }
	.square:nth-child(13) { animation-delay: 1.0s; opacity: 0.18; }
	.square:nth-child(14) { animation-delay: 1.3s; opacity: 0.15; }
	.square:nth-child(15) { animation-delay: 0.7s; opacity: 0.18; }

	@keyframes pulse {
		0%, 100% {
			transform: scale(1);
		}
		50% {
			transform: scale(1.3);
		}
	}

	.hero-container {
		max-width: 900px;
		margin: 0 auto;
		text-align: center;
		position: relative;
		z-index: 1;
	}

	.hero-title {
		font-family: 'Squada One', system-ui, sans-serif;
		font-size: 3rem;
		margin: 0;
		color: rgb(251, 113, 133);
	}

	.hero-subtitle {
		font-size: 1.5rem;
		margin: 0 0 1.5rem 0;
		color: white;
	}

	.hero-description {
		font-size: 1.125rem;
		line-height: 1.8;
		opacity: 0.9;
	}

	/* Section Headings */
	.section-heading {
		font-family: 'Squada One', system-ui, sans-serif;
		font-size: 2.5rem;
		text-align: center;
		margin: 0 0 3rem 0;
		color: rgb(251, 113, 133);
	}

	.heading-prefix {
		color: white;
	}

	/* Speakers Section */
	.speakers-section {
		padding: 1.25rem 1.5rem 4rem;
	}

	.speakers-container {
		max-width: 1200px;
		margin: 0 auto;
	}

	.speakers-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 2rem;
	}

	.speakers-grid--detailed {
		gap: 2.5rem;
	}

	.speaker-card {
		background: rgba(61, 120, 171, 0.1);
		border: 1px solid rgba(61, 120, 171, 0.2);
		border-radius: 1rem;
		padding: 2rem;
		text-align: center;
		transition: transform 0.2s, border-color 0.2s;
	}

	.speaker-card--detailed {
		display: flex;
		flex-direction: column;
		align-items: stretch;
		gap: 1.5rem;
		text-align: left;
	}

	.speaker-card:hover {
		transform: translateY(-4px);
		border-color: rgba(61, 120, 171, 0.4);
	}

	.speaker-card--detailed .speaker-image {
		margin: 0 auto;
		flex-shrink: 0;
	}

	.speaker-image {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		max-width: 260px;
		min-height: 200px;
		margin: 0 auto 1.25rem;
		border-radius: 1rem;
		overflow: hidden;
		border: 2px solid rgba(251, 113, 133, 0.6);
		background: rgba(255, 255, 255, 0.04);
	}

	.speaker-image img {
		width: auto;
		max-width: 100%;
		height: auto;
		max-height: 240px;
		object-fit: contain;
		object-position: center center;
		display: block;
	}

	.speaker-info {
		text-align: center;
	}

	.speaker-card--detailed .speaker-info {
		text-align: left;
		min-width: 0;
	}

	.speaker-name {
		font-family: 'Squada One', system-ui, sans-serif;
		font-size: 1.5rem;
		margin: 0 0 0.5rem 0;
		color: white;
	}

	.speaker-title {
		font-size: 1rem;
		margin: 0 0 0.25rem 0;
		font-weight: 600;
		color: rgb(251, 113, 133);
	}

	.speaker-company {
		font-size: 0.875rem;
		margin: 0 0 0.75rem 0;
		opacity: 0.8;
	}

	.speaker-topic {
		font-size: 0.875rem;
		margin: 0;
		opacity: 0.7;
		font-style: italic;
	}

	.speaker-linkedin {
		margin: 0.75rem 0 0 0;
		font-size: 1rem;
		font-weight: 600;
	}

	.speaker-linkedin a {
		color: rgb(113, 198, 251);
		text-decoration: none;
	}

	.speaker-linkedin a:hover {
		text-decoration: underline;
	}

	.speaker-detail-heading {
		font-family: 'Squada One', system-ui, sans-serif;
		font-size: 1.125rem;
		font-weight: 400;
		margin: 1.25rem 0 0.5rem 0;
		color: rgb(255, 193, 77);
		letter-spacing: 0.02em;
	}

	.speaker-detail-heading:first-of-type {
		margin-top: 0.75rem;
	}

	.speaker-bio {
		margin: 0;
		font-size: 1rem;
		line-height: 1.65;
		opacity: 0.92;
	}

	.speaker-talk-headline {
		margin: 0 0 0.5rem 0;
		font-size: 1.125rem;
		font-weight: 600;
		line-height: 1.4;
		color: rgb(251, 113, 133);
	}

	.speaker-talk-level-tag {
		margin: 0 0 0.25rem 0;
		font-size: 0.8125rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		opacity: 0.85;
	}

	/* Call for Speakers */
	.cfs-section {
		padding: 4rem 1.5rem;
		background: rgba(61, 120, 171, 0.05);
	}

	.cfs-container {
		max-width: 1200px;
		margin: 0 auto;
		text-align: center;
	}

	.cfs-description {
		font-size: 1.125rem;
		margin: 0 auto 3rem;
		max-width: 800px;
		opacity: 0.9;
		line-height: 1.8;
	}

	.cfs-dates {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.5rem;
		margin-bottom: 3rem;
		max-width: 600px;
		margin-left: auto;
		margin-right: auto;
	}

	.cfs-date-card {
		background: rgba(251, 113, 133, 0.1);
		border: 1px solid rgba(251, 113, 133, 0.3);
		border-radius: 1rem;
		padding: 1.5rem;
		text-align: center;
	}

	.cfs-date-card h3 {
		font-family: 'Squada One', system-ui, sans-serif;
		font-size: 1.5rem;
		margin: 0 0 0.5rem 0;
		color: white;
	}

	.date-label {
		font-size: 0.875rem;
		margin: 0;
		opacity: 0.7;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.date-value {
		font-size: 1.5rem;
		font-weight: 700;
		margin: 0.5rem 0 0 0;
		color: rgb(251, 113, 133);
	}

	.cfs-benefits {
		display: grid;
		grid-template-columns: 1fr;
		gap: 2rem;
		margin-bottom: 3rem;
	}

	.benefit-item {
		background: rgba(61, 120, 171, 0.1);
		border: 1px solid rgba(61, 120, 171, 0.2);
		border-radius: 1rem;
		padding: 2rem;
		text-align: left;
	}

	.benefit-item h3 {
		font-family: 'Squada One', system-ui, sans-serif;
		font-size: 1.5rem;
		margin: 0 0 0.75rem 0;
		color: rgb(251, 113, 133);
	}

	.benefit-item p {
		margin: 0;
		opacity: 0.9;
		line-height: 1.6;
	}

	.cfs-button {
		display: inline-block;
		padding: 1rem 3rem;
		background: rgb(251, 113, 133);
		color: white;
		text-decoration: none;
		font-weight: 600;
		border-radius: 0.5rem;
		font-size: 1.125rem;
		transition: transform 0.2s, opacity 0.2s;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.cfs-button:hover {
		transform: translateY(-2px);
		opacity: 0.9;
	}

	/* Opportunities Section */
	.opportunities-section {
		padding: 4rem 1.5rem;
	}

	.opportunities-container {
		max-width: 1200px;
		margin: 0 auto;
	}

	.opportunities-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 2rem;
	}

	.opportunity-card {
		background: rgba(61, 120, 171, 0.1);
		border: 1px solid rgba(61, 120, 171, 0.2);
		border-radius: 1rem;
		padding: 2rem;
		text-align: center;
	}

	.opportunity-card h3 {
		font-family: 'Squada One', system-ui, sans-serif;
		font-size: 1.75rem;
		margin: 0 0 0.5rem 0;
		color: rgb(251, 113, 133);
	}

	.duration {
		font-size: 0.875rem;
		font-weight: 600;
		margin: 0 0 1rem 0;
		color: rgb(255, 193, 77);
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.opportunity-card p:not(.duration) {
		margin: 0;
		opacity: 0.9;
		line-height: 1.6;
	}

	/* Desktop Styles */
	@media (min-width: 769px) {
		.speakers-hero {
			padding: 6rem 2rem 1.5rem;
		}

		.hero-title {
			font-size: 4.5rem;
		}

		.hero-subtitle {
			font-size: 2rem;
		}

		.hero-description {
			font-size: 1.25rem;
		}

		.speakers-section {
			padding: 1.5rem 2rem 6rem;
		}

		.section-heading {
			font-size: 4rem;
		}

		.speakers-grid--detailed {
			gap: 3rem;
		}

		.speaker-card--detailed {
			flex-direction: row;
			align-items: flex-start;
			gap: 2.5rem;
			padding: 2.25rem 2.5rem;
		}

		.speaker-card--detailed .speaker-image {
			margin: 0;
			max-width: 240px;
			min-height: 220px;
		}

		.speaker-card--detailed .speaker-image img {
			max-height: 260px;
		}

		.speaker-image {
			max-width: 280px;
			min-height: 260px;
		}

		.speaker-image img {
			max-height: 280px;
		}

		.cfs-section {
			padding: 6rem 2rem;
		}

		.cfs-dates {
			grid-template-columns: repeat(2, 1fr);
			max-width: 700px;
		}

		.cfs-benefits {
			grid-template-columns: repeat(2, 1fr);
			gap: 3rem;
		}

		.opportunities-section {
			padding: 6rem 2rem;
		}

		.opportunities-grid {
			grid-template-columns: repeat(2, 1fr);
			gap: 3rem;
		}
	}
</style>
